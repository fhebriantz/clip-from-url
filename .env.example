# Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini untuk analisis video
GEMINI_MODEL=gemini-3.6-flash

# Browser sumber cookies untuk yt-dlp (chrome / firefox / edge / brave).
# BIARKAN KOSONG kecuali benar-benar perlu. Dari koneksi rumahan, request anonim
# justru lebih sering dilayani penuh; membawa cookie akun login malah membuat
# YouTube menahan seluruh stream. Isi ini hanya untuk video berbatasan umur
# atau khusus member - dan cookie tetap dicoba paling terakhir.
YTDLP_COOKIES_FROM_BROWSER=

# Port server lokal
PORT=8765
