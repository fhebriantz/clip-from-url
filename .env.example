# Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini untuk menulis naskah video
GEMINI_MODEL=gemini-3.6-flash

# Suara narator: "gemini" (lebih hidup, bisa diatur gayanya, memakai kuota API)
# atau "edge" (gratis penuh, tapi cuma 2 suara Indonesia dan terdengar datar).
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Port server lokal
PORT=8765
