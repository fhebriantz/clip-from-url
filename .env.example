# Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini untuk menulis naskah video
GEMINI_MODEL=gemini-3.6-flash

# Suara narator: "gemini" (lebih hidup, bisa diatur gayanya, memakai kuota API)
# atau "edge" (gratis penuh, tapi cuma 2 suara Indonesia dan terdengar datar).
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Dicoba berurutan kalau model TTS utama kehabisan kuota atau sedang sibuk.
GEMINI_TTS_FALLBACKS=gemini-2.5-flash-preview-tts

# Kedalaman penalaran saat menulis naskah: "low" (hemat, disarankan),
# "medium", "high", atau "default" untuk mengikuti bawaan model.
GEMINI_THINKING=low

# Berapa job diproses berbarengan. Manfaatnya hanya terasa saat mengantre
# beberapa produk; untuk job tunggal tidak berpengaruh.
JOB_WORKERS=2

# Pembersihan aset unggahan otomatis.
ASSET_ORPHAN_HOURS=24
ASSET_KEEP_DAYS=7

# Port server lokal
PORT=8765
