# Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini untuk analisis video
GEMINI_MODEL=gemini-2.5-flash

# Browser sumber cookies untuk yt-dlp (chrome / firefox / edge / brave).
# Kosongkan kalau tidak perlu. Berguna kalau kena "Sign in to confirm you're not a bot".
YTDLP_COOKIES_FROM_BROWSER=

# Port server lokal
PORT=8765
