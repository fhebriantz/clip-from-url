# Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini untuk menulis naskah video
GEMINI_MODEL=gemini-3.6-flash

# Suara narator: "gemini" (lebih hidup, bisa diatur gayanya, memakai kuota API)
# atau "edge" (gratis penuh, tapi cuma 2 suara Indonesia dan terdengar datar).
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Dicoba berurutan kalau model TTS utama kehabisan kuota atau sedang sibuk.
GEMINI_TTS_FALLBACKS=gemini-2.5-flash-preview-tts

# Kedalaman penalaran saat menulis naskah: "low" (hemat, disarankan),
# "medium", "high", atau "default" untuk mengikuti bawaan model.
GEMINI_THINKING=low

# Berapa job diproses berbarengan. Manfaatnya hanya terasa saat mengantre
# beberapa produk; untuk job tunggal tidak berpengaruh.
JOB_WORKERS=1

# Pembersihan aset unggahan otomatis.
ASSET_ORPHAN_HOURS=24
ASSET_KEEP_DAYS=7

# Berkas antara per job (potongan scene, penggalan suara). Disisakan sebentar
# supaya job yang gagal masih bisa diperiksa, lalu dibuang.
WORK_KEEP_HOURS=24

# Folder tempat video dan caption disimpan. Arahkan ke folder yang tersinkron ke
# HP supaya hasilnya langsung sampai tanpa dipindahkan manual. Kosongkan untuk
# memakai data/output di dalam folder proyek.
#   Windows : OUTPUT_DIR=G:\My Drive\Affiliate\video
#   Linux   : OUTPUT_DIR=~/GoogleDrive/Affiliate/video
#
# JANGAN pakai tanda kutip ganda di Windows. Backslash di dalamnya akan
# diterjemahkan sebagai kode khusus - "...\video" berubah jadi karakter tab
# vertikal + "ideo", dan foldernya jadi salah tanpa pesan error.
#   BENAR : OUTPUT_DIR=G:\My Drive\Affiliate\video
#   SALAH : OUTPUT_DIR="G:\My Drive\Affiliate\video"
OUTPUT_DIR=

# Port server lokal
PORT=8765

# Alamat yang didengarkan server.
#   127.0.0.1 = hanya dari komputer ini (bawaan, paling aman)
#   0.0.0.0   = bisa dibuka dari HP di WiFi yang sama
HOST=127.0.0.1

# WAJIB diisi kalau HOST=0.0.0.0. Aplikasi ini tidak punya login, jadi tanpa PIN
# siapa pun di WiFi yang sama bisa memakai kuota API-mu dan mengunggah berkas.
# Pakai angka atau huruf bebas, misalnya 482913.
ACCESS_PIN=
